# Kopyala: cp .env.example .env  (asla commit etme)

# AI sağlayıcı: mock | gemini  (ileride: claude, openai)
AI_PROVIDER=mock
GEMINI_API_KEY=

DATABASE_URL=postgresql+psycopg://artapp:artapp@localhost:5433/artapp
REDIS_URL=redis://localhost:6379/0

# Çizim yüklemeleri (dev: yerel disk; prod: R2/S3)
STORAGE_DIR=./storage

# Faz bayrakları
MENTOR_MARKET_ENABLED=false
