# Kopyala: cp .env.example .env  (gerçek anahtarları asla commit etme)

# AI sağlayıcı: mock | gemini | openrouter
# NOT: Bu dosyayı değiştirince backend'i YENİDEN BAŞLAT (ayarlar önbellekli).
AI_PROVIDER=mock

# OpenRouter: ücretsiz anahtar → https://openrouter.ai/settings/keys (kart gerekmez)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

GEMINI_API_KEY=

# Google Sign-In (web/server OAuth client ID — bkz. DEPLOY.md)
GOOGLE_CLIENT_ID=

# Kullanıcı başına günlük AI analiz limiti
AI_DAILY_LIMIT=10

DATABASE_URL=postgresql+psycopg://artapp:artapp@localhost:5433/artapp
REDIS_URL=redis://localhost:6379/0

# local (dev) | s3 (prod: Cloudflare R2)
STORAGE_BACKEND=local
STORAGE_DIR=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

SENTRY_DSN=
MENTOR_MARKET_ENABLED=false
